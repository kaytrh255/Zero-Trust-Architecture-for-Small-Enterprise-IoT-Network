# Local development values only. Do not reuse these credentials in a deployed environment.
POSTGRES_DB=zerotrust
POSTGRES_ADMIN_PASSWORD=local_admin_password_change_me
# Runtime login: application DML only; do not reuse the Flyway migration credentials.
DB_USERNAME=zerotrust_app
DB_PASSWORD=local_app_password_change_me
# Flyway login: separate DDL-capable role used for schema migrations.
DB_MIGRATION_USERNAME=zerotrust_migrator
DB_MIGRATION_PASSWORD=local_migration_password_change_me
# Generate local keys with: openssl rand -base64 32
JWT_SECRET=
# Stable AES-256 key used to encrypt TOTP seeds at rest; back it up securely.
MFA_ENCRYPTION_KEY=
# When enabled, ADMIN and SECURITY_ANALYST accounts must enroll in MFA before receiving an access token.
MFA_REQUIRE_PRIVILEGED=true
JWT_EXPIRATION_SECONDS=3600
# Login requests per source IP in a fixed window; backend keeps counters in memory only.
AUTH_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT_MAX_TRACKED_CLIENTS=10000
# Local bootstrap administrator; replace this password before using the demo.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME="Zero Trust Administrator"
ADMIN_PASSWORD=local_bootstrap_admin_password_change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Local Mosquitto Dynamic Security administrator and backend subscriber.
# Per-device MQTT usernames/passwords are issued by POST /api/devices and stored by Mosquitto.
MQTT_DYNSEC_ADMIN_USERNAME=admin
MQTT_DYNSEC_ADMIN_PASSWORD=local_mqtt_dynsec_admin_password_change_me
MQTT_BACKEND_USERNAME=zero-trust-backend
MQTT_BACKEND_PASSWORD=local_backend_mqtt_password_change_me
MQTT_PORT=8883
MQTT_CLIENT_ID=zero-trust-backend
MQTT_TELEMETRY_TOPIC=iot/telemetry/+
