# Local development values only. Do not reuse these credentials in a deployed environment.
POSTGRES_DB=zerotrust
POSTGRES_ADMIN_PASSWORD=local_admin_password_change_me
DB_USERNAME=zerotrust_app
DB_PASSWORD=local_app_password_change_me
# Generate a local signing key with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600
# Local bootstrap administrator; replace this password before using the demo.
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Zero Trust Administrator
ADMIN_PASSWORD=local_bootstrap_admin_password_change_me
POSTGRES_PORT=5432
BACKEND_PORT=8080

# Local Mosquitto Dynamic Security administrator and backend subscriber.
# Per-device MQTT usernames/passwords are issued by POST /api/devices and stored by Mosquitto.
MQTT_DYNSEC_ADMIN_USERNAME=admin
MQTT_DYNSEC_ADMIN_PASSWORD=local_mqtt_dynsec_admin_password_change_me
MQTT_BACKEND_USERNAME=zero-trust-backend
MQTT_BACKEND_PASSWORD=local_backend_mqtt_password_change_me
MQTT_PORT=8883
MQTT_CLIENT_ID=zero-trust-backend
MQTT_TELEMETRY_TOPIC=iot/telemetry/+
